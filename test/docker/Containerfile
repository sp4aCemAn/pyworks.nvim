# pyworks.nvim test environment — tools-only image.
#
# Plugins, venvs, and kernelspecs live in the bind-mounted sandbox
# (test/.sandbox -> /sandbox), populated on demand by the entrypoint.
# Rebuild only when this file changes; code changes need no rebuild.
#
# build:  docker build -t pyworks-nvim-test test/docker
#         (or: ./test/container.sh build)
# arch:   picks the right Neovim tarball for the host arch (arm64/x86_64)

FROM ubuntu:24.04

ARG NVIM_VERSION=stable

ENV DEBIAN_FRONTEND=noninteractive \
	UV_LINK_MODE=copy

RUN apt-get update && apt-get install -y --no-install-recommends \
	ca-certificates \
	curl \
	git \
	python3 \
	python3-pip \
	python3-venv \
	tar \
	xz-utils \
	&& rm -rf /var/lib/apt/lists/*

# uv powers the sandbox venvs (the plugin's preferred package manager)
RUN python3 -m pip install --no-cache-dir --break-system-packages uv

# Neovim release tarball, arch-aware
RUN set -eux; \
	arch="$(dpkg --print-architecture)"; \
	case "$arch" in \
	arm64) nvim_arch="nvim-linux-arm64" ;; \
	amd64) nvim_arch="nvim-linux-x86_64" ;; \
	*) echo "unsupported arch: $arch" >&2; exit 1 ;; \
	esac; \
	curl -fsSL "https://github.com/neovim/neovim/releases/download/${NVIM_VERSION}/${nvim_arch}.tar.gz" \
	-o /tmp/nvim.tar.gz; \
	tar -xzf /tmp/nvim.tar.gz -C /opt; \
	ln -s "/opt/${nvim_arch}/bin/nvim" /usr/local/bin/nvim; \
	rm /tmp/nvim.tar.gz; \
	nvim --version | head -n 2

COPY entrypoint.sh /usr/local/bin/pyworks-entrypoint
RUN chmod +x /usr/local/bin/pyworks-entrypoint

WORKDIR /work/pyworks.nvim

ENTRYPOINT ["/usr/local/bin/pyworks-entrypoint"]
